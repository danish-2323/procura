# Procura 2.0 Environment Configuration
# Copy this file to .env and adjust variables as needed

# Application
APP_ENV=local
SERVER_PORT=8080
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16 with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procura
DB_USER=procura_app
DB_PASSWORD=procura_secret_change_me
DB_ROOT_PASSWORD=postgres_root_secret

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Seed Demo Credentials
DEMO_DEFAULT_PASSWORD=Procura2026!Demo

# S3 / MinIO File Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=procura-files
STORAGE_REGION=us-east-1

# AI Gateway (Phase 7+ only, disabled by default)
AI_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
